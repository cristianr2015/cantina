{
  "name": "cantina-bufet",
  "version": "0.1.0",
  "description": "Aplicación para administrar cantina y bufet (ventas, productos, eventos, reportes)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-syntax.js",
    "test": "npm run check && node --test",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "ios:init": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.3",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "nodemon": "^3.1.14"
  }
}
