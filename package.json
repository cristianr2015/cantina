    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.2.0"
  },
  "optionalDependencies": {
    "multer": "npm:null@*"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "nodemon": "^3.1.14"
  }
}
